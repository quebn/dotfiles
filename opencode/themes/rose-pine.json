{
  "base": {
    "categorical": [
      "purple",
      "red",
      "cyan",
      "orange"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "#eb6f92"
        },
        "warning": {
          "base": "$hue.orange.200"
        },
        "success": {
          "base": "#31748f"
        },
        "info": {
          "base": "$hue.interactive.200"
        }
      }
    },
    "background": {
      "base": "transparent",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "#eb6f92"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#403d52"
    },
    "scrollbar": {
      "base": "$hue.interactive.200"
    },
    "diff": {
      "text": {
        "added": "#31748f",
        "removed": "#eb6f92",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.purple.200"
      },
      "background": {
        "added": "#1f2d3a",
        "removed": "#3a1f2d",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#31748f",
        "removed": "#eb6f92"
      },
      "lineNumber": {
        "text": "#9491a6",
        "background": {
          "added": "#1f2d3a",
          "removed": "#3a1f2d"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "#31748f",
      "function": "$hue.accent.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.orange.200",
      "number": "$hue.purple.200",
      "type": "$hue.interactive.200",
      "operator": "#908caa",
      "punctuation": "#908caa"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.purple.200",
      "link": "$hue.interactive.200",
      "linkText": "$hue.accent.200",
      "code": "#31748f",
      "blockQuote": "$hue.neutral.400",
      "emphasis": "$hue.orange.200",
      "strong": "#eb6f92",
      "horizontalRule": "#403d52",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "$hue.accent.200",
      "image": "$hue.interactive.200",
      "imageText": "$hue.accent.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "light": {
